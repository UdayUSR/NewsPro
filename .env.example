# NewsPro Production & Development Environment Variables Template
# Copy this file to .env and fill in your actual private credentials.

# Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Editorial Control Room Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Session Cryptographic Secret Key
SECRET_KEY=your_super_secret_random_hex_key_here

